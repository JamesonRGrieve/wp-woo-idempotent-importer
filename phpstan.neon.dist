includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - tools
        - wp-woo-idempotent-importer.php
        - uninstall.php
    excludePaths:
        - tests/e2e/wordpress (?)
    # FluentCRM (a dev dependency from wpackagist), the WordPress home of CRM data: its models are scanned, not analysed.
    scanDirectories:
        - vendor/wpackagist-plugin/fluent-crm/app/Models
        - vendor/wpackagist-plugin/fluent-crm/database/migrations
        - vendor/wpackagist-plugin/fluent-crm/vendor/wpfluent/framework/src
    bootstrapFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
