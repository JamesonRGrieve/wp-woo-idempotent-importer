{
    "name": "jamesonrgrieve/wp-woo-idempotent-importer",
    "description": "One-way, idempotent, continuously re-runnable store (Shopify, Etsy, BigCommerce, Wix, Squarespace, Square, Ecwid, Magento) to WooCommerce importer for WordPress.",
    "type": "wordpress-plugin",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Jameson Grieve"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "php-stubs/woocommerce-stubs": "^10.0",
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "symfony/yaml": "^7.3",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "webonyx/graphql-php": "^15.20",
        "wpackagist-plugin/fluent-crm": "3.2.6"
    },
    "autoload": {
        "psr-4": {
            "IdempotentImporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IdempotentImporter\\Tests\\": "tests/",
            "IdempotentImporter\\Tools\\": "tools/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/installers": false
        }
    },
    "scripts": {
        "post-install-cmd": "git config core.hooksPath .githooks",
        "lint": "find src tests tools wp-woo-idempotent-importer.php uninstall.php -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "format": "php-cs-fixer fix",
        "format-check": "php-cs-fixer fix --dry-run --diff",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit --testsuite unit",
        "schema": "php tools/fetch-schema.php",
        "validate-graphql": "php tools/validate-graphql.php",
        "specs": "php tools/fetch-specs.php",
        "validate-fixtures": "php tools/validate-fixtures.php",
        "e2e": [
            "Composer\\Config::disableProcessTimeout",
            "tests/e2e/run.sh"
        ],
        "check": [
            "@lint",
            "@format-check",
            "@analyse",
            "@test",
            "@validate-graphql",
            "@validate-fixtures",
            "@composer audit",
            "@composer validate --strict"
        ]
    },
    "repositories": {
        "wpackagist": {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    }
}
